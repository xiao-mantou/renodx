+static void logDL2SwapchainAtProxySetup(IUnknown* swapchain, UINT d3dVersion)
+{
+    const uint32_t index = g_dl2SwapchainSetupAuditCount.fetch_add(1, std::memory_order_relaxed);
+    if (index >= 16 || swapchain == nullptr)
+        return;
+
+    Microsoft::WRL::ComPtr<IDXGISwapChain3> swapchain3;
+    const HRESULT queryHr = swapchain->QueryInterface(__uuidof(IDXGISwapChain3), &swapchain3);
+    if (FAILED(queryHr))
+    {
+        SL_LOG_INFO("DL2 SC AUDIT PROXY_SETUP[%u] d3d=%u native=0x%p query_hr=0x%08X", index, d3dVersion, swapchain, static_cast<uint32_t>(queryHr));
+        return;
+    }
+
+    DXGI_SWAP_CHAIN_DESC1 desc{};
+    const HRESULT descHr = swapchain3->GetDesc1(&desc);
+    SL_LOG_INFO("DL2 SC AUDIT PROXY_SETUP[%u] d3d=%u native=0x%p desc_hr=0x%08X format=%u size=%ux%u buffers=%u flags=0x%X usage=0x%X",
+        index, d3dVersion, swapchain3.Get(), static_cast<uint32_t>(descHr), static_cast<uint32_t>(desc.Format),
+        desc.Width, desc.Height, desc.BufferCount, desc.Flags, desc.BufferUsage);
+
+    if (FAILED(descHr) || d3dVersion != 12)
+        return;
+
+    for (UINT buffer = 0; buffer < desc.BufferCount && buffer < 8; ++buffer)
+    {
+        Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+        const HRESULT bufferHr = swapchain3->GetBuffer(buffer, IID_PPV_ARGS(&resource));
+        const DXGI_FORMAT format = SUCCEEDED(bufferHr) ? resource->GetDesc().Format : DXGI_FORMAT_UNKNOWN;
+        SL_LOG_INFO("DL2 SC AUDIT PROXY_BACKBUFFER[%u] index=%u get_hr=0x%08X resource=0x%p format=%u",
+            index, buffer, static_cast<uint32_t>(bufferHr), resource.Get(), static_cast<uint32_t>(format));
+    }
+}
 
