+static_assert(offsetof(DXGIFactory, m_base) == 16, "This location must be maintained to keep compatibility with Nsight tools");
+
+static std::atomic<uint32_t> g_dl2FactorySwapchainAuditCount{0};
+
+static void logDL2FactoryNativeSwapchain(IDXGISwapChain1* swapchain, UINT d3dVersion)
+{
+    const uint32_t index = g_dl2FactorySwapchainAuditCount.fetch_add(1, std::memory_order_relaxed);
+    if (index >= 16 || swapchain == nullptr)
+        return;
+
+    DXGI_SWAP_CHAIN_DESC1 desc{};
+    const HRESULT descHr = swapchain->GetDesc1(&desc);
+    SL_LOG_INFO("DL2 SC AUDIT FACTORY_NATIVE[%u] native=0x%p d3d=%u desc_hr=0x%08X format=%u size=%ux%u buffers=%u flags=0x%X usage=0x%X",
+        index, swapchain, d3dVersion, static_cast<uint32_t>(descHr), static_cast<uint32_t>(desc.Format),
+        desc.Width, desc.Height, desc.BufferCount, desc.Flags, desc.BufferUsage);
+
+    if (FAILED(descHr) || d3dVersion != 12)
+        return;
+
+    for (UINT buffer = 0; buffer < desc.BufferCount && buffer < 8; ++buffer)
+    {
+        Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+        const HRESULT bufferHr = swapchain->GetBuffer(buffer, IID_PPV_ARGS(&resource));
+        const DXGI_FORMAT format = SUCCEEDED(bufferHr) ? resource->GetDesc().Format : DXGI_FORMAT_UNKNOWN;
+        SL_LOG_INFO("DL2 SC AUDIT FACTORY_BACKBUFFER[%u] index=%u get_hr=0x%08X resource=0x%p format=%u",
+            index, buffer, static_cast<uint32_t>(bufferHr), resource.Get(), static_cast<uint32_t>(format));
+    }
+}
 
