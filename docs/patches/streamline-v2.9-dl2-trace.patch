 static sl::interposer::ExportedFunction hookCreateSwapChainForComposition("IDXGIFactory2::CreateSwapChainForComposition");
 
+static std::atomic<uint32_t> g_dl2SwapchainAuditCount{0};
+
+static void logDL2NativeSwapchain(const char* stage, IDXGISwapChain1* swapchain)
+{
+    const uint32_t index = g_dl2SwapchainAuditCount.fetch_add(1, std::memory_order_relaxed);
+    if (index >= 16 || swapchain == nullptr)
+        return;
+
+    Microsoft::WRL::ComPtr<IDXGISwapChain3> swapchain3;
+    HRESULT hr = swapchain->QueryInterface(__uuidof(IDXGISwapChain3), reinterpret_cast<void**>(&swapchain3));
+    if (FAILED(hr))
+    {
+        SL_LOG_INFO("DL2 SC AUDIT[%u] %s native=0x%p query_sc3_hr=0x%08X", index, stage, swapchain, static_cast<uint32_t>(hr));
+        return;
+    }
+
+    DXGI_SWAP_CHAIN_DESC1 desc{};
+    hr = swapchain3->GetDesc1(&desc);
+    const DXGI_COLOR_SPACE_TYPE colorSpace = swapchain3->GetColorSpace1();
+    SL_LOG_INFO("DL2 SC AUDIT[%u] %s native=0x%p desc_hr=0x%08X format=%u size=%ux%u buffers=%u flags=0x%X color_space=%u",
+        index, stage, swapchain3.Get(), static_cast<uint32_t>(hr), static_cast<uint32_t>(desc.Format),
+        desc.Width, desc.Height, desc.BufferCount, desc.Flags, static_cast<uint32_t>(colorSpace));
+
+    if (SUCCEEDED(hr))
+    {
+        for (UINT buffer = 0; buffer < desc.BufferCount && buffer < 8; ++buffer)
+        {
+            Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+            const HRESULT bufferHr = swapchain3->GetBuffer(buffer, IID_PPV_ARGS(&resource));
+            const DXGI_FORMAT format = SUCCEEDED(bufferHr) ? resource->GetDesc().Format : DXGI_FORMAT_UNKNOWN;
+            SL_LOG_INFO("DL2 SC AUDIT[%u] %s backbuffer=%u get_hr=0x%08X resource=0x%p format=%u",
+                index, stage, buffer, static_cast<uint32_t>(bufferHr), resource.Get(), static_cast<uint32_t>(format));
+        }
+    }
+}
+
 void loadDXGIModule();
 
 
