+
+static bool beginDL2Present1Trace(uint32_t& traceIndex)
+{
+    if (g_dl2Present1TraceRemaining.load(std::memory_order_relaxed) == 0)
+    {
+        const uint32_t poll = g_dl2Present1ArmPollCount.fetch_add(1, std::memory_order_relaxed);
+        if ((poll & 15u) != 0)
+        {
+            return false;
+        }
+        static const std::wstring armPath = sl::file::getModulePath() + L"\\dl2_streamline_trace.arm";
+        const DWORD attributes = GetFileAttributesW(armPath.c_str());
+        if (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0 && DeleteFileW(armPath.c_str()))
+        {
+            g_dl2Present1TraceCount.store(0, std::memory_order_relaxed);
+            g_dl2Present1TraceRemaining.store(256, std::memory_order_relaxed);
+            SL_LOG_INFO("DL2 SL Present1 trace armed path=%ls frames=256", armPath.c_str());
+        }
+    }
+
+    uint32_t remaining = g_dl2Present1TraceRemaining.load(std::memory_order_relaxed);
+    while (remaining != 0)
+    {
+        if (g_dl2Present1TraceRemaining.compare_exchange_weak(
+                remaining, remaining - 1, std::memory_order_relaxed, std::memory_order_relaxed))
+        {
+            traceIndex = g_dl2Present1TraceCount.fetch_add(1, std::memory_order_relaxed);
+            return true;
+        }
+    }
+    return false;
+}
 
